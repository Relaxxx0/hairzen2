# Hairzen React - Environment Variables
# Copy this file to .env.local for local development
# For production, set these in your hosting platform (Vercel, Netlify, etc.)

# === Site & SEO ===
# Production URL without trailing slash (used for canonical URLs, sitemap.xml, hreflang)
VITE_SITE_URL=https://www.hairzendogukandenli.com

# === Google Analytics 4 ===
# Measurement ID format: G-XXXXXXXXXX
VITE_GA_ID=G-XXXXXXXXXX

# === Google Ads ===
# Conversion tag ID format: AW-XXXXXXXXX
VITE_ADS_ID=AW-XXXXXXXXX
# Lead conversion label (from Google Ads conversion action)
VITE_ADS_LEAD_LABEL=XXXXXXXXXXXX

# === Google Search Console ===
# HTML tag verification code (only the content="..." value)
# google-site-verification=WG5q4IAB60voSxeCsm33Gg4zHwBxGt6rfiJJw1vsLNI → sonrası:
VITE_SEARCH_CONSOLE_VERIFICATION=WG5q4IAB60voSxeCsm33Gg4zHwBxGt6rfiJJw1vsLNI

# === Sentry Error Tracking ===
# DSN from Sentry project settings (Client Key / DSN)
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o123456.ingest.sentry.io/123456
# Environment name: production, staging, development
VITE_SENTRY_ENVIRONMENT=production
# Release version (git tag, commit SHA, or semver)
VITE_SENTRY_RELEASE=1.0.0